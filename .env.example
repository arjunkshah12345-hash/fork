# Agent CLIs normally use their existing login sessions. Do not commit credentials.
# OPENAI_API_KEY=
# CURSOR_API_KEY=

# NVIDIA Nemotron on Nebius Token Factory (--agent nemotron).
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model IDs are discovered from GET /v1/models; override per tier if needed:
# FORK_NEMOTRON_NANO_MODEL=
# FORK_NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# FORK_NEMOTRON_ULTRA_MODEL=
# FORK_NEMOTRON_MOCK=1   # scripted stand-in for the demo task, no key, no model calls

# Tavily web research before each run, plus a web_search tool for Nemotron candidates.
# TAVILY_API_KEY=

# Public demo deployment: only the bundled demo task, on Nemotron, one run at a time.
# FORK_HOSTED_DEMO=1

# Optional binary overrides for server environments with non-standard PATHs.
# FORK_CODEX_BIN=codex
# FORK_OPENCODE_BIN=opencode
# FORK_CURSOR_BIN=cursor-agent
# FORK_FREEBUFF_BIN=freebuff
# FORK_SUPERCOMPRESS_BIN=supercompress
# FORK_PYTHON_BIN=python3

# SuperCompress uses the local Python package first (`pip install supercompress`).
# This hosted fallback is optional. Never expose it as NEXT_PUBLIC_*.
# SUPERCOMPRESS_API_KEY=sc_live_...

# Signs the local FORK session cookie. Required in production (32+ characters):
# openssl rand -base64 32
# Development/tests use a deterministic, explicitly non-production fallback
# when this is unset so a local checkout launches without setup.
# AUTH_SECRET=

# Optional Greptile review. Leave FORK_USE_GREPTILE=false to score locally.
FORK_USE_GREPTILE=false
# GREPTILE_API_KEY=

# Optional GitHub PR publication. Local paths and repos without a GitHub remote
# stay local. A token needs only the permissions required to push a branch and
# create a pull request in the target repository.
# GITHUB_TOKEN=
